# Copy to .env and adjust. Loaded by Makefile targets and the binaries.
DATABASE_URL=postgres://charging:charging@localhost:5433/charging?sslmode=disable

# EnergyVision DATEX II (AFIR) API key, sent as "Authorization: Bearer …" on the
# table+status pair. Free key via myevplatform@energyvision.be — NOTE: keys
# expire every 6 months and must be re-requested by email.
ENERGYVISION_TOKEN=

# Tesla Belgium roaming feed (transportdata.be NAP), OCPI 2.2.1. The NAP hands
# out the credential already base64-encoded: prefix it with "base64:" so the
# OCPI client sends it verbatim instead of re-encoding it (which would 401).
# Locations + live status only (Tesla exposes no tariffs/price module).
TESLA_TOKEN=

# Monta Public API credentials, "clientId:clientSecret" (for the 'monta' source)
MONTA_CREDS=

# Eco-Movement NAP aggregator (DATEX II, ~20 networks). The token authenticates
# via a ?token= query param; the feed folds it into the URL. Coverage-only.
ECOMOVEMENT_TOKEN=

# API server
API_ADDR=:8080
CORS_ORIGINS=*                 # comma-separated allowed origins for browser clients
ADMIN_TOKEN=                   # bearer token for /admin/*; empty = admin disabled

# OCPI eMSP (acting as a data consumer). PUBLIC_URL is the externally reachable
# API base — used to advertise our absolute /ocpi endpoints in the handshake.
PUBLIC_URL=                    # e.g. https://charging.appmire.be/api
OCPI_COUNTRY=BE
OCPI_PARTY_ID=APM
OCPI_PARTY_NAME=Appmire Charging

# Reference vehicle for the comparable session prices (defaults: mid-size EV)
VEHICLE_USABLE_KWH=60
VEHICLE_CONSUMPTION_KWH100=18

# Local DB image override (docker-compose.prod.yml `db` service). The official
# postgis/postgis:17-3.5 is amd64-only; on Apple Silicon set a multi-arch image
# so the local replica DB runs native arm64 instead of under QEMU emulation.
# Leave unset elsewhere. See docs/local-replica.md.
#DB_IMAGE=imresamu/postgis:17-3.5

# Operational tuning
AVAILABILITY_STALE_AFTER=15m   # availability older than this = not "available"
PRICE_STALE_AFTER=48h          # readiness: max age of last successful price ingest
METRICS_ADDR=:9090             # ingest process Prometheus /metrics

# First-party analytics (server-side, no cookies/consent banner). Secret salt for
# the daily-rotated visitor hashing; keeps unique-visitor counts stable across
# restarts. Leave empty to use a per-process random salt.
ANALYTICS_SALT=
# Raw analytics events older than this many days are pruned; the daily rollup
# archive (analytics_daily) keeps the aggregates. Default 90.
ANALYTICS_RETENTION_DAYS=90

# Open bulk dataset export (static dumps served at /export). Empty dir disables.
EXPORT_DIR=./export
EXPORT_FULL_EVERY=5m           # full NDJSON/GeoJSON/OCPI/DATEX-table snapshot cadence
EXPORT_AVAIL_EVERY=1m          # availability-delta (+ DATEX status) cadence

# DATEX II v3 AFIR feed (also under /export/datex, XML + JSON). publicationCreator
# identity of the feed we emit.
DATEX_CREATOR_COUNTRY=BE
DATEX_CREATOR_ID=APM
# Outbound DATEX II push to subscriber callbacks (the mirror of the Mobilithek
# push we consume). Empty disables push (pull-only). Entries are separated by
# newlines or commas; each is "url[|token][|xml|json]" (encoding defaults to xml,
# token falls back to DATEX_PUSH_TOKEN). Mutual-TLS via the cert/key/ca paths.
DATEX_PUSH_TARGETS=
DATEX_PUSH_TOKEN=
DATEX_PUSH_CERT_FILE=
DATEX_PUSH_KEY_FILE=
DATEX_PUSH_CA_FILE=
DATEX_PUSH_TIMEOUT=120s

# Corridor search (GET /chargers/along-route). Base URL of a self-hosted
# osrm-routed server; empty disables it. With docker-compose.osrm.yml this is
# set automatically to http://osrm:5000 (run ./scripts/osrm-prep.sh once first).
OSRM_URL=
# Which prepared OSRM graph the osrm service loads (/data/<OSRM_GRAPH>.osrm),
# and what osrm-prep.sh builds. Dev default belgium-latest; for cross-country
# routing run e.g. OSRM_GRAPH=eu-west OSRM_REGIONS="europe/belgium europe/netherlands
# europe/luxembourg europe/germany europe/france" ./scripts/osrm-prep.sh
OSRM_GRAPH=belgium-latest

# DE Mobilithek (AFIR DATEX II — live availability + ad-hoc price). Mutual-TLS
# org client certificate (PEM paths inside the container; mount them in). Then
# add one source per CPO/aggregator offering with the two subscription pull URLs:
#   chargingctl sources add de-<cpo> --type mobilithek \
#     --url "<static-subscription-url>|<status-subscription-url>"
# See docs/mobilithek.md. Leave empty to disable.
MOBILITHEK_CERT_FILE=
MOBILITHEK_KEY_FILE=
MOBILITHEK_CA_FILE=
# Static-reconcile pull: push delivery is delta-based and can drop the static
# (locations + price) snapshot, so the ingester also PULLS each source's static
# from the Mobilithek M2M API on a slow, staggered cadence and ingests it like a
# push. Set a source's pull_static_id (the static subscription id) to enable it.
# Status stays on push (a slow status pull would only be stale).
MOBILITHEK_M2M_BASE=https://m2m.mobilithek.info/mobilithek/api/v1.0/subscription
MOBILITHEK_PULL_EVERY=24h
MOBILITHEK_PULL_STAGGER=60s
# Mobilithek consumer-push (webhook): the broker POSTs AFIR DATEX II (JSON or
# XML) to POST /mobilithek/push?token=<this>. Register that tokenized URL on
# Mobilithek. Empty disables the receiver.
MOBILITHEK_PUSH_TOKEN=
# Optional debug: capture dir logs per-request metadata (requests.jsonl).
MOBILITHEK_CAPTURE_DIR=
# Durable push queue: the webhook writes each push here and worker(s) drain it
# into the DB (decoupled, restart-safe). Empty = ingest inline in a goroutine.
# Workers autoscale 1..MOBILITHEK_WORKERS to the backlog (the cap protects the DB);
# per-CPO locking lets different operators ingest in parallel.
MOBILITHEK_SPOOL_DIR=
MOBILITHEK_WORKERS=8

# Map basemap: self-hosted vector tiles (shared appmire infra, tiles.appmire.be —
# PMTiles + MapLibre styles, gated by a coarse ?key= that ships in the client).
# Injected into the web container at runtime (→ /config.js). Empty → the map
# falls back to raster OpenStreetMap. The key is NOT secret-grade (it's in the
# client bundle) but keep it in the vault, not this public repo.
TILES_URL=                     # e.g. https://tiles.appmire.be
TILES_KEY=
