# Binaries. `go build ./cmd/...` drops these at the repo root, and two of them
# (api, migrate) were committed by accident — a 24 MB and a 14 MB artifact in a
# public repo. Keep them out.
/bin/
/api
/ingest
/migrate
/chargingctl
cmd/api/api
cmd/ingest/ingest
*.exe

# Env / secrets
.env
.env.local

# Go
*.test
*.out
coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Cached official DATEX II schemas (scripts/validate-datex.sh downloads them)
.datex-xsd/

# Generated bulk dataset dumps
/export/

# Server-local docker compose overrides (e.g. arm64 db image, loopback ports)
docker-compose.override.yml
docker-compose.*.local.yml
docker-compose.appmire.yml

# OSRM bind-mounted data (downloaded/processed on the host)
osrm-data/

# mTLS client certs / secrets (Mobilithek etc.) — never commit
secrets/

# Ansible secrets. The vault PASSWORD and copy-mode plain files never get
# committed; group_vars/charging/vault.yml IS committed but only ever encrypted
# (ansible-vault). Never `ansible-vault decrypt` it in place.
deploy/ansible/.vault-pass
deploy/ansible/files/

# Local DB dumps pulled from production (real data + secrets — never commit).
backups/
