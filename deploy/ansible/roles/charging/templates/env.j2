# Managed by Ansible (deploy/ansible/group_vars/charging/vault.yml).
# Do not edit on the box — changes are overwritten on the next deploy.
{% for k, v in charging_env.items() %}
{{ k }}={{ v }}
{% endfor %}
{% if charging_env.DB_USER is defined %}
# Which of the two interchangeable runtime login roles the app connects as, and
# its password picked out of the pair above. Rotating means: set a new password
# for the IDLE role and deploy (no effect on anything running), then point
# DB_USER at it and deploy again. See docs/db-credentials.md.
DB_PASSWORD={{ charging_env['DB_PASSWORD_' ~ (charging_env.DB_USER | upper)] }}
{% endif %}
# OSRM graph name (non-secret; selects /data/<graph>.osrm in the osrm service).
OSRM_GRAPH={{ osrm_graph }}
# Durable Mobilithek push spool + autoscale cap (workers scale 1..this to backlog).
MOBILITHEK_SPOOL_DIR=/spool
MOBILITHEK_WORKERS={{ mobilithek_workers | default(8) }}
# Mobilithek mutual-TLS client cert (M2M static reconcile pull). Mounted read-only
# at /secrets by the hetz1 compose override; the ingester pulls each source's
# static (pull_static_id) on MOBILITHEK_PULL_EVERY, staggered by _STAGGER.
MOBILITHEK_CERT_FILE=/secrets/mob-cert.pem
MOBILITHEK_KEY_FILE=/secrets/mob-key.pem
MOBILITHEK_PULL_EVERY={{ mobilithek_pull_every | default('24h') }}
MOBILITHEK_PULL_STAGGER={{ mobilithek_pull_stagger | default('60s') }}
{% if mobilithek_capture | default(false) %}
# Debug: persist every received Mobilithek push to this (bind-mounted) dir.
MOBILITHEK_CAPTURE_DIR=/capture
{% endif %}
